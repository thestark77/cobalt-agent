# cobalt.env — VPS-local deploy config for cobalt-agent (NOT committed).
#
# Copy this to ~/.hermes/cobalt.env on the VPS and fill in your values.
# install.sh and update.sh source it at deploy time to substitute
# placeholders in SOUL.md (e.g. {{COBALT_BOT_EMAIL}}), so per-deployment
# values are never hardcoded in the repo.
#
#   cp cobalt.env.example ~/.hermes/cobalt.env
#   $EDITOR ~/.hermes/cobalt.env
#   chmod 600 ~/.hermes/cobalt.env
#
# Then re-run:  bash update.sh   (re-merges SOUL.md and restarts the gateway)

# The bot's own Google account (used by the google-workspace calendar rules).
# Not a secret, but kept here so it is configurable per deployment.
export COBALT_BOT_EMAIL="cobaltstarkbot@gmail.com"
